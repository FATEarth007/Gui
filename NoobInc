local Library = loadstring(game:HttpGet(
	"https://raw.githubusercontent.com/FATEarth007/Gui/refs/heads/main/FateUI.lua"
))()

local Window = Library:CreateWindow({
	Title = "FatE Hub"
})

local World6 = Window:CreateTab("World 6")
local TitanSection = World6:CreateSection("Titan")

TitanSection:CreateToggle({
	Name = "Auto Titan",
	Default = false,
	Callback = function(enabled)
		print("Auto Titan:", enabled)
	end
})

TitanSection:CreateDropdown({
	Name = "Titan Upgrades",
	Options = {
		"HydraDamage",
		"HydraAttackInterval",
		"HydraTitanYield"
	},
	Multi = true,
	Callback = function(selected)
		print("Selected:", table.concat(selected, ", "))
	end
})

TitanSection:CreateSlider({
	Name = "Action Interval",
	Min = 0.25,
	Max = 5,
	Default = 1,
	Increment = 0.25,
	Callback = function(value)
		print("Interval:", value)
	end
})
print("8 - Titan loop started")
