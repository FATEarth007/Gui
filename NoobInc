local Library = loadstring(game:HttpGet(
	"https://raw.githubusercontent.com/FATEarth007/Gui/refs/heads/main/FateUI.lua"
))()

local Window = Library:CreateWindow({
	Title = "FatE Hub"
})

-- World 6
local World6 = Window:CreateTab("World 6")

-- Titan Section
local TitanSection = World6:CreateSection("Titan")

local AutoTitanEnabled = false
local SelectedTitanUpgrades = {}
local TitanInterval = 1

-- Auto Titan
TitanSection:CreateToggle({
	Name = "Auto Titan",
	Default = false,

	Callback = function(enabled)
		AutoTitanEnabled = enabled
		print("Auto Titan:", enabled)
	end
})

-- Titan Upgrades
TitanSection:CreateDropdown({
	Name = "Titan Upgrades",

	Options = {
		"HydraDamage",
		"HydraAttackInterval",
		"HydraTitanYield"
	},

	Multi = true,

	Callback = function(selected)
		SelectedTitanUpgrades = selected

		print("Selected Titan upgrades:")

		for _, upgradeName in ipairs(selected) do
			print("-", upgradeName)
		end
	end
})

-- Interval
TitanSection:CreateSlider({
	Name = "Action Interval",
	Min = 0.25,
	Max = 5,
	Default = 1,
	Increment = 0.25,

	Callback = function(value)
		TitanInterval = value
		print("Titan interval:", value)
	end
})

-- Test loop
task.spawn(function()
	while true do
		if AutoTitanEnabled and #SelectedTitanUpgrades > 0 then
			for _, upgradeName in ipairs(SelectedTitanUpgrades) do
				if not AutoTitanEnabled then
					break
				end

				print("Would process:", upgradeName)

				task.wait(TitanInterval)
			end
		else
			task.wait(0.1)
		end
	end
end)
